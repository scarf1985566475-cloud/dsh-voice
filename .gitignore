# Model weights: multi-gigabyte, fetched on demand by `dsh-voice download-model`.
models/
.hf/

# Meeting records. These are the operator's own transcripts — recorded speech,
# names, whatever was said in the room. They stay on the machine that recorded
# them and are never published.
meetings/
recordings/

# Runtime output
logs/

# Audio generated by the tests and the self-test (regenerated on every run).
selftest/*.aiff
selftest/*.wav
selftest/*.m4a

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Editors and the OS
.DS_Store
.idea/
.vscode/
